<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="StrObj">
    <description>PSR-12 with the statement spacing used in examples/02-crud/web.php.</description>

    <file>src</file>
    <file>tests</file>
    <file>tools</file>
    <file>examples</file>
    <arg name="extensions" value="php" />
    <arg name="tab-width" value="4" />
    <arg name="encoding" value="utf-8" />

    <rule ref="PSR12">
        <!-- Existing property names are retained for compatibility and continuity. -->
        <exclude name="PSR2.Classes.PropertyDeclaration.Underscore" />
        <exclude name="Generic.WhiteSpace.ScopeIndent" />
    </rule>
    <rule ref="Squiz.Commenting.DocCommentAlignment" />
    <rule ref="./tools/Standards/StrObj/Sniffs/WhiteSpace/ScopeIndentSniff.php" />
    <rule ref="./tools/Standards/StrObj/Sniffs/WhiteSpace/StatementSpacingSniff.php" />
</ruleset>
