{
    "name": "uuur86/strobj",
    "description": "Read, write, validate and filter nested arrays, objects and JSON documents with slash-separated paths.",
    "type": "library",
    "keywords": [
        "json",
        "path",
        "array",
        "object",
        "nested",
        "dot-notation",
        "data-access",
        "validation",
        "filter"
    ],
    "homepage": "https://github.com/uuur86/strobj",
    "license": "MIT",
    "authors": [
        {
            "name": "Uğur Biçer",
            "email": "contact@fyndsoft.com",
            "role": "lead"
        }
    ],
    "support": {
        "issues": "https://github.com/uuur86/strobj/issues",
        "source": "https://github.com/uuur86/strobj",
        "docs": "https://github.com/uuur86/strobj/wiki",
        "security": "https://github.com/uuur86/strobj/security/policy"
    },
    "require": {
        "php": ">=7.4",
        "ext-json": "*"
    },
    "require-dev": {
        "phpmetrics/phpmetrics": "^2.8",
        "phpstan/phpstan": "^1.8",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "StrObj\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StrObj\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-3.0.x-dev": "3.0.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:regression": "phpunit --testsuite Regression",
        "test:integration": "phpunit --testsuite Integration",
        "test:coverage": [
            "phpunit --coverage-clover build/coverage/clover.xml --coverage-html build/coverage/html --coverage-text",
            "@php tools/check-coverage.php build/coverage/clover.xml"
        ],
        "test:coverage:phpdbg": [
            "phpdbg -qrr vendor/bin/phpunit --coverage-clover build/coverage/clover.xml --coverage-html build/coverage/html --coverage-text",
            "@php tools/check-coverage.php build/coverage/clover.xml"
        ],
        "format": "@php tools/format.php",
        "format:check": "phpcs --standard=phpcs.xml",
        "phpstan": "phpstan analyse",
        "analyze": "php ./vendor/bin/phpmetrics --report-html=docs/report ."
    }
}
